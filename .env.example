# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Resend (Email Service)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@your-domain.com"

# Slack (Optional - for Slack integrations)
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:3000/api/integrations/slack/callback"

# LLM Providers (Optional - for workflow generation)
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
AGENT_FAST_MODEL="llama-3.3-70b-versatile"
AGENT_OPENROUTER_MODEL="openai/gpt-4o-mini"
AGENT_PROVIDER_TIMEOUT_MS="20000"
LLM_PROVIDER_TIMEOUT_MS="20000"
AGENT_MAX_OUTPUT_TOKENS="500"
AGENT_MAX_CONTEXT_TOKENS="12000"
AGENT_DAILY_TOKEN_LIMIT="100000"
AGENT_DAILY_REQUEST_LIMIT="200"
AGENT_WORKSPACE_CACHE_TTL_SECONDS="300"
# Release controls. General is the default; use internal for an allowlisted rollout.
AGENT_ENABLED="true"
FAILURE_MONITOR_ENABLED="true"
AGENT_RELEASE_MODE="general"
AGENT_INTERNAL_EMAILS="owner@example.com"
# AGENT_INTERNAL_USER_IDS="00000000-0000-0000-0000-000000000000"
# Optional. Reasoning is used only when a request crosses the complexity gate.
# AGENT_REASONING_MODEL="your-openrouter-reasoning-model"
SITE_URL="http://localhost:3000"
SITE_DOMAIN="localhost"

# App Configuration
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
RESUME_SECRET="your-resume-secret"
